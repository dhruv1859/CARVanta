  ;; ═══════════════════════════════════════════════════════════════
  ;; ZONE DEFINITIONS
  ;; ═══════════════════════════════════════════════════════════════

  ;; ZONE 1: Digital Ground (In1.Cu) — Full board except analog cutout
  ;; ZONE 2: Analog Ground (In1.Cu) — Bottom-left quadrant only
  ;; ZONE 3: Connected via single ferrite bead at (45, 42)
  ;;
  ;; ANALOG ZONE BOUNDARY (Eco1.User layer):
  ;;   Rectangle from (0, 35) to (50, 65)
  ;;   This area contains: U9-U12 (LMP91000), U13 (ADS1256), U14 (TCA9548A)
  ;;   Ground plane has a GAP along this boundary on In1.Cu
  ;;   Connected by L1 ferrite bead at boundary crossing point

  ;; ═══════════════════════════════════════════════════════════════
  ;; COMPONENT PLACEMENT GUIDE
  ;; ═══════════════════════════════════════════════════════════════
  ;;
  ;; ┌──────────────────────────────────────────────────────────────────┐
  ;; │ J1(USB-C)   U3(BQ24075)  U4(LDO_D) U5(LDO_A)     LOGO        │
  ;; │  [5,2]       [18,5]       [30,5]    [40,5]       [75,5]        │
  ;; │                                                                  │
  ;; │ J7(BATT)  SW3(PWR)          U1 (ESP32-S3)          J6(TFT FPC) │
  ;; │  [5,18]   [5,25]            [47,22]                [88,22]     │
  ;; │                          (center of board)                      │
  ;; │                                                     J9(SpO2)   │
  ;; │ U17(RTC) Y1               ┌─ ─ ─ ─ ─ ─ ─ ─┐      [88,35]    │
  ;; │  [5,35]                   │ ANALOG DOMAIN   │                   │
  ;; │ ┌─────────────────────────┤                 │  LED1-4  BZ1     │
  ;; │ │ U14(I2C MUX) [10,42]   │  U13(ADS1256)  │  [75,50] [85,50] │
  ;; │ │                         │   [30,48]       │                   │
  ;; │ │ U9  U10  U11  U12      │                 │  SW1 SW2          │
  ;; │ │ [8,55] [18,55] [28,55] [38,55]           │  [75,58] [82,58] │
  ;; │ └─────────────────────────┴─ ─ ─ ─ ─ ─ ─ ─┘                   │
  ;; │ J2(CH1) J3(CH2) J4(CH3) J5(CH4)     J8(JTAG)    U18(SD)      │
  ;; │ [8,63]  [18,63] [28,63] [38,63]     [60,63]     [88,58]      │
  ;; └──────────────────────────────────────────────────────────────────┘
  ;;
  ;; CRITICAL ROUTING RULES:
  ;; 1. Analog traces (L3 only) — no digital signals cross analog zone
  ;; 2. USB D+/D- on L5 — 90Ω differential, length matched ±0.1mm
  ;; 3. SPI clock on L1 — 3.3V domain, keep under 20mm
  ;; 4. Ferrite bead L1 bridges AGND↔DGND at (45, 42)
  ;; 5. No vias in analog zone except analog signal vias
  ;; 6. Star ground for 4× sensor connectors
  ;; ═══════════════════════════════════════════════════════════════
)
