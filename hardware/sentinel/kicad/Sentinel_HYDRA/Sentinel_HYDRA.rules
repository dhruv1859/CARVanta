
(rules PCB Sentinel_HYDRA.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 150.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 37.6 (type smd))
    (clearance 150.0 (type "kicad_default"))
    (clearance 150.0 (type "USB_DP ,Default"))
    (clearance 140.0 (type Power,Default))
    (clearance 140.0 (type Analog,Default))
  )
  (padstack "Via[0-5]_300:300_um"
    (shape
      (circle "Digital_Signals" 300.0 0.0 0.0)
    )
    (shape
      (circle "GND_Plane" 300.0 0.0 0.0)
    )
    (shape
      (circle "Analog_Signals" 300.0 0.0 0.0)
    )
    (shape
      (circle "Power_Planes" 300.0 0.0 0.0)
    )
    (shape
      (circle HighSpeed 300.0 0.0 0.0)
    )
    (shape
      (circle "Bottom_GND" 300.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-5]_600:400_um"
    (shape
      (circle "Digital_Signals" 600.0 0.0 0.0)
    )
    (shape
      (circle "GND_Plane" 600.0 0.0 0.0)
    )
    (shape
      (circle "Analog_Signals" 600.0 0.0 0.0)
    )
    (shape
